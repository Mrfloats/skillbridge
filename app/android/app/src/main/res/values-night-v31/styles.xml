<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw the launch screen from these attributes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_mark</item>
    </style>
</resources>
